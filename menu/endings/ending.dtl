[clear time="0.0" background="false" positions="false" style="false"]
if {goodEnding} == true:
	audio music "res://menu/endings/goodEnding.mp3"
	[background arg="res://menu/endings/FinalBueno_1.png" fade="1.0" wait="true"]
	# Good ending :D
	[wait time="3.0" hide_text="false"]
	label goodEnding
	[background arg="res://menu/endings/FinalBueno_2.png" fade="6.0" wait="true"]
	[background arg="res://menu/endings/FinalBueno_1.png" fade="6.0" wait="true"]
	jump goodEnding
else:
	audio music "res://menu/endings/badEnding.mp3"
	[background arg="res://menu/endings/FinalMalo_1.png" fade="1.0"]
	# Bad ending D:
	[wait time="3.0" hide_text="false" skippable="true"]
	label badEnding
	[background arg="res://menu/endings/FinalMalo_2.png" fade="6.0" wait="true"]
	[background arg="res://menu/endings/FinalMalo_1.png" fade="6.0" wait="true"]
	jump badEnding